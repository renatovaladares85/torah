<section class="mt-4" data-torah-policy-matrix>
   <fieldset class="border rounded p-3">
      <legend class="fs-4 px-2">{{ __('Assistance', 'torah') }}</legend>
      <section class="mb-4">
         <div class="table-responsive">
            <table class="table table-sm table-hover card-table align-middle mb-0">
               <thead>
                  <tr>
                     <th scope="col">{{ __('Field', 'torah') }}</th>
                     <th scope="col" class="text-center text-nowrap">
                        {{ __('Opening', 'torah') }}
                        <button class="btn btn-sm p-0 border-0" type="button" data-bs-toggle="tooltip" title="{{ __('When selected, this field is read-only while a ticket is being created in the GLPI interface.', 'torah') }}" aria-label="{{ __('Opening', 'torah') }}">
                           <i class="ti ti-info-circle" aria-hidden="true"></i>
                        </button>
                     </th>
                     <th scope="col" class="text-center text-nowrap">
                        {{ __('Update', 'torah') }}
                        <button class="btn btn-sm p-0 border-0" type="button" data-bs-toggle="tooltip" title="{{ __('When selected, this field is read-only while an existing ticket is being edited in the GLPI interface.', 'torah') }}" aria-label="{{ __('Update', 'torah') }}">
                           <i class="ti ti-info-circle" aria-hidden="true"></i>
                        </button>
                     </th>
                     <th scope="col" class="text-center text-nowrap">
                        {{ __('Backend', 'torah') }}
                        <button class="btn btn-sm p-0 border-0" type="button" data-bs-toggle="tooltip" title="{{ __('When selected, the restriction will also apply to changes made through API, cron, automation, integrations, plugins, or backend code.', 'torah') }}" aria-label="{{ __('Backend', 'torah') }}">
                           <i class="ti ti-info-circle" aria-hidden="true"></i>
                        </button>
                     </th>
                     <th scope="col" class="text-center text-nowrap">{{ __('All', 'torah') }}</th>
                  </tr>
               </thead>
               <tbody>
                  {% for field in policy_model.field_rules %}
                     {% set opening_checked = false %}
                     {% for rule_key in field.add_keys %}{% if blocked_rules[rule_key] is defined %}{% set opening_checked = true %}{% endif %}{% endfor %}
                     {% set update_checked = false %}
                     {% for rule_key in field.update_keys %}{% if blocked_rules[rule_key] is defined %}{% set update_checked = true %}{% endif %}{% endfor %}
                     {% set backend_checked = false %}
                     {% for rule_key in field.add_keys|merge(field.update_keys) %}{% if backend_rule_keys[rule_key] is defined %}{% set backend_checked = true %}{% endif %}{% endfor %}
                     <tr data-torah-field-row data-torah-field-label="{{ field.label|lower|e('html_attr') }}">
                        <th scope="row">
                           <span>{{ field.label }}</span>
                           {% if field.key in ['requester', 'observer', 'assignee'] %}
                              <button class="btn btn-sm p-0 border-0 ms-1" type="button" data-bs-toggle="tooltip" title="{{ __('Opening, Update, and Backend control whether the actor field can be changed. The globally allowed actor types determine which kinds of actors can be added when the field is editable.', 'torah') }}" aria-label="{{ field.label }}">
                                 <i class="ti ti-info-circle" aria-hidden="true"></i>
                              </button>
                           {% endif %}
                           {% if field.sensitive %}
                              <button class="btn btn-sm p-0 border-0 ms-1" type="button" data-bs-toggle="tooltip" title="{{ __('This field may be updated automatically by GLPI. Backend enforcement can affect API, cron, rules and internal processes.', 'torah') }}" aria-label="{{ field.label }}">
                                 <i class="ti ti-info-circle" aria-hidden="true"></i>
                              </button>
                           {% endif %}
                        </th>
                        <td class="text-center">
                           <label class="visually-hidden" for="{{ matrix_id }}-{{ field.key }}-opening">{{ __('Opening', 'torah') }}: {{ field.label }}</label>
                           <input class="form-check-input" type="checkbox" id="{{ matrix_id }}-{{ field.key }}-opening" data-torah-action="opening"
                                  name="blocked_controls[opening][]" value="{{ field.key }}"
                                  {{ opening_checked ? 'checked' : '' }}>
                        </td>
                        <td class="text-center">
                           <label class="visually-hidden" for="{{ matrix_id }}-{{ field.key }}-update">{{ __('Update', 'torah') }}: {{ field.label }}</label>
                           <input class="form-check-input" type="checkbox" id="{{ matrix_id }}-{{ field.key }}-update" data-torah-action="update"
                                  name="blocked_controls[update][]" value="{{ field.key }}"
                                  {{ update_checked ? 'checked' : '' }}>
                        </td>
                        <td class="text-center">
                           <label class="visually-hidden" for="{{ matrix_id }}-{{ field.key }}-backend">{{ __('Backend', 'torah') }}: {{ field.label }}</label>
                           <input class="form-check-input" type="checkbox" id="{{ matrix_id }}-{{ field.key }}-backend" data-torah-action="backend"
                                  name="backend_controls[]" value="{{ field.key }}"
                                  {{ backend_checked ? 'checked' : '' }}
                                  {{ (opening_checked or update_checked) ? '' : 'disabled' }}>
                        </td>
                        <td class="text-center"><label class="visually-hidden" for="{{ matrix_id }}-{{ field.key }}-all">{{ __('All', 'torah') }}: {{ field.label }}</label><input class="form-check-input" type="checkbox" id="{{ matrix_id }}-{{ field.key }}-all" data-torah-row-all></td>
                     </tr>
                  {% endfor %}
               </tbody>
               <tfoot><tr data-torah-column-row><th scope="row">{{ __('All', 'torah') }}</th>{% for action in ['opening', 'update', 'backend'] %}<td class="text-center"><label class="visually-hidden" for="{{ matrix_id }}-{{ action }}-all">{{ __('All', 'torah') }}: {{ __(action|capitalize, 'torah') }}</label><input class="form-check-input" type="checkbox" id="{{ matrix_id }}-{{ action }}-all" data-torah-column-all="{{ action }}"></td>{% endfor %}<td></td></tr></tfoot>
            </table>
         </div>
      </section>
   </fieldset>
</section>
