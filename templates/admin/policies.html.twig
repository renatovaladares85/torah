<div class="container-fluid">
   <div class="alert alert-info" role="status">
      {{ __('Checked means blocked.', 'torah') }}
      {{ __('Unchecked rules do not change GLPI behavior.', 'torah') }}
   </div>

   <section class="mb-4">
      <h2 class="h3 mb-3">{{ __('New policy set', 'torah') }}</h2>
      <form method="post" action="{{ action }}" data-submit-once data-torah-policy-form>
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <fieldset class="border rounded p-3">
            <legend class="fs-5 px-2">{{ __('Policy scope', 'torah') }}</legend>
            <div class="row g-3">
               <div class="col-md-5">
                  <label class="form-label">{{ __('Profile', 'torah') }}</label>
                  {{ new_profile|raw }}
               </div>
               <div class="col-md-5">
                  <label class="form-label">{{ __('Entity', 'torah') }}</label>
                  {{ new_entity|raw }}
               </div>
               <div class="col-md-2 d-flex align-items-end">
                  <label class="form-check">
                     <input class="form-check-input" type="checkbox" name="is_recursive" value="1">
                     <span class="form-check-label">{{ __('Recursive', 'torah') }}</span>
                  </label>
               </div>
            </div>
            <p class="form-text mb-0 mt-3">{{ __('The policy applies to the selected profile and entity. When recursive is enabled, it may also apply to descendant entities.', 'torah') }}</p>
         </fieldset>
         {% include '@torah/admin/rule_matrix.html.twig' with {
            'policy_model': policy_model,
            'blocked_rules': {},
            'actor_itemtypes': new_actor_itemtypes,
            'matrix_id': 'new-policy'
         } only %}
         <button class="btn btn-primary mt-3" type="submit" name="save" value="1">
            {{ _x('button', 'Add') }}
         </button>
      </form>
   </section>

   {% for set in sets %}
      <section class="mb-4">
         <h2 class="h3 mb-3">{{ set.profile_name }} / {{ set.entity_name }}</h2>
         <form method="post" action="{{ action }}" data-submit-once data-torah-policy-form>
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ set.id }}">
            <input type="hidden" name="profiles_id" value="{{ set.profile_id }}">
            <input type="hidden" name="entities_id" value="{{ set.entity_id }}">
            {% for rule_key in set.preserved_blocked_rules %}
               <input type="hidden" name="blocked_rules[]" value="{{ rule_key }}">
            {% endfor %}
            <fieldset class="border rounded p-3">
               <legend class="fs-5 px-2">{{ __('Policy scope', 'torah') }}</legend>
               <div class="row g-3">
                  <div class="col-md-5">
                     <strong>{{ __('Profile', 'torah') }}:</strong> {{ set.profile_name }}
                  </div>
                  <div class="col-md-5">
                     <strong>{{ __('Entity', 'torah') }}:</strong> {{ set.entity_name }}
                  </div>
                  <div class="col-md-2">
                     <label class="form-check">
                        <input class="form-check-input" type="checkbox" name="is_recursive" value="1" {{ set.recursive ? 'checked' : '' }}>
                        <span class="form-check-label">{{ __('Recursive', 'torah') }}</span>
                     </label>
                  </div>
               </div>
               <p class="form-text mb-0 mt-3">{{ __('The policy applies to the selected profile and entity. When recursive is enabled, it may also apply to descendant entities.', 'torah') }}</p>
            </fieldset>
            {% include '@torah/admin/rule_matrix.html.twig' with {
               'policy_model': policy_model,
               'blocked_rules': set.blocked_rules,
               'actor_itemtypes': set.actor_itemtypes,
               'matrix_id': 'policy-' ~ set.id
            } only %}
            <div class="d-flex gap-2 mt-3">
               <button class="btn btn-primary" type="submit" name="save" value="1">{{ _x('button', 'Save') }}</button>
               <button class="btn btn-outline-danger" type="submit" name="delete" value="1"
                       onclick="return confirm('{{ __('Remove this policy set?', 'torah')|e('js') }}');">
                  {{ _x('button', 'Delete permanently') }}
               </button>
            </div>
         </form>
      </section>
   {% else %}
      <div class="alert alert-secondary">{{ __('No policy set is configured.', 'torah') }}</div>
   {% endfor %}
</div>
