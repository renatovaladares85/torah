<div class="container-fluid">
   <section class="mb-4">
      <form method="post" action="{{ action }}" data-submit-once data-torah-policy-form>
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <div class="row g-3 align-items-end">
               <div class="col-md-4">
                  <label class="form-label">{{ __('Entity', 'torah') }}</label>
                  {{ new_entity|raw }}
               </div>
               <div class="col-md-4">
                  <label class="form-label">{{ __('Profile', 'torah') }}</label>
                  {{ new_profile|raw }}
               </div>
               <div class="col-md-2">
                  <label class="form-check">
                     <input class="form-check-input" type="checkbox" name="is_recursive" value="1">
                     <span class="form-check-label">{{ __('Recursive', 'torah') }}</span>
                  </label>
               </div>
               <div class="col-md-2">
                  <button class="btn btn-primary w-100" type="submit" name="save" value="1">{{ _x('button', 'Add') }}</button>
               </div>
         </div>
      </form>
   </section>

   {% if profile_groups %}
      <div class="accordion accordion-flush mb-4" id="torah-profile-policies">
      {% for profile_group in profile_groups %}
         <section class="accordion-item">
            <h2 class="accordion-header" id="torah-profile-heading-{{ profile_group.id }}">
               <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                       data-bs-target="#torah-profile-collapse-{{ profile_group.id }}" aria-expanded="false"
                       aria-controls="torah-profile-collapse-{{ profile_group.id }}">
                  {{ profile_group.name }}
                  <span class="badge bg-secondary ms-2">{{ profile_group.sets|length }}</span>
               </button>
            </h2>
            <div id="torah-profile-collapse-{{ profile_group.id }}" class="accordion-collapse collapse"
                 aria-labelledby="torah-profile-heading-{{ profile_group.id }}" data-bs-parent="#torah-profile-policies">
               <div class="accordion-body px-0 pt-3">
                  {% for set in profile_group.sets %}
                     <section class="mb-4">
                        <h3 class="h5 mb-3">{{ set.entity_name }} — {{ set.recursive ? __('Recursive', 'torah') : __('Not recursive', 'torah') }}</h3>
                        <form method="post" action="{{ action }}" data-submit-once data-torah-policy-form>
                           <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                           <input type="hidden" name="id" value="{{ set.id }}">
                           <input type="hidden" name="profiles_id" value="{{ set.profile_id }}">
                           <input type="hidden" name="entities_id" value="{{ set.entity_id }}">
                           {% for rule_key in set.preserved_blocked_rules %}
                              <input type="hidden" name="blocked_rules[]" value="{{ rule_key }}">
                           {% endfor %}
                           <input type="hidden" name="is_recursive" value="{{ set.recursive ? '1' : '0' }}">
                           {% include '@torah/admin/rule_matrix.html.twig' with {
                              'policy_model': policy_model,
                              'blocked_rules': set.blocked_rules,
                              'backend_rule_keys': set.backend_rule_keys,
                              'actor_itemtypes': set.actor_itemtypes,
                              'matrix_id': 'policy-' ~ set.id
                           } only %}
                           <div class="d-flex gap-2 mt-3">
                              <button class="btn btn-outline-secondary" type="button" data-torah-select-all>{{ __('Select all', 'torah') }}</button>
                              <button class="btn btn-outline-secondary" type="button" data-torah-clear-all>{{ __('Clear all', 'torah') }}</button>
                              <button class="btn btn-primary" type="submit" name="save" value="1">{{ _x('button', 'Save') }}</button>
                              <button class="btn btn-outline-danger" type="submit" name="delete" value="1"
                                      onclick="return confirm('{{ __('Remove this entity configuration?', 'torah')|e('js') }}');">
                                 {{ __('Remove', 'torah') }}
                              </button>
                           </div>
                        </form>
                     </section>
                  {% endfor %}
               </div>
            </div>
         </section>
      {% endfor %}
      </div>
   {% else %}
      <div class="alert alert-secondary">{{ __('No policy set is configured.', 'torah') }}</div>
   {% endif %}
</div>
